#
# Files git should not track here.
# Node packages for the browser kit (npm i beside it).
node_modules/
# Python byte code from the kits.
*.pyc
__pycache__/
# Release tarballs written by bin/ship.sh.
dist/
# Output folders the browser kit writes when run from the repo
# (out-topoforge/ by default).
out-*/
